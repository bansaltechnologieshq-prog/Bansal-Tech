# Supabase — Project Settings > API. Keep the secret key server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Admin sign-in for /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
